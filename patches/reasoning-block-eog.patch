+static size_t count_finite(struct llama_sampler * sampler, llama_token max_token) {
+    std::vector<llama_token_data> cur;
+    for (llama_token i = 0; i <= max_token; i++) {
+        cur.emplace_back(llama_token_data{i, logf((float) (i + 1)), 0.0f});
+    }
+
+    llama_token_data_array cur_p = { cur.data(), cur.size(), -1, false };
+    llama_sampler_apply(sampler, &cur_p);
+
+    size_t finite = 0;
+    for (const auto & td : cur) {
+        finite += std::isfinite(td.logit) ? 1 : 0;
+    }
+    return finite;
+}
+
+static void test_reasoning_budget_blocked_tokens() {
+    const std::vector<llama_token> start = {100};
+    const std::vector<llama_token> end = {101};
+    const llama_tokens blocked = {2, 7};
+    const llama_token max_token = 110;
+
+    auto * sampler = common_reasoning_budget_init(nullptr, {start}, {end}, {101}, INT_MAX, REASONING_BUDGET_IDLE, blocked);
+
+    GGML_ASSERT(count_finite(sampler, max_token) == (size_t) max_token + 1 && "tokens blocked before the block opens");
+
+    llama_sampler_accept(sampler, 100);
+    GGML_ASSERT(count_finite(sampler, max_token) == (size_t) max_token - 1 && "tokens not blocked inside the block");
+
+    auto * clone = llama_sampler_clone(sampler);
+    GGML_ASSERT(count_finite(clone, max_token) == (size_t) max_token - 1 && "clone lost the blocked tokens");
+    llama_sampler_free(clone);
+
+    llama_sampler_accept(sampler, 50);
+    GGML_ASSERT(count_finite(sampler, max_token) == (size_t) max_token - 1 && "tokens not blocked after a token inside the block");
+
+    llama_sampler_accept(sampler, 101);
+    GGML_ASSERT(count_finite(sampler, max_token) == (size_t) max_token + 1 && "tokens still blocked after the block closed");
+
+    // a second block is guarded as well
+    llama_sampler_accept(sampler, 100);
+    GGML_ASSERT(count_finite(sampler, max_token) == (size_t) max_token - 1 && "second block not guarded");
+
+    llama_sampler_free(sampler);
+}
