# Copy this file to ".env" and fill in the values. ".env" is ignored by Git.

# Hugging Face access token; only used while building the images, and only
# needed for gated or rate-limited downloads. It is not stored in the images.
HF_TOKEN=

# Server settings. Leave a setting commented out (or empty) to use the image's
# default; see the header of mistral-serve for details.
#CONTEXT_SIZE=262144
#CUDA_VISIBLE_DEVICES=0
#MMPROJ=/models/mmproj-BF16.gguf
#MODEL=
#PARALLEL=1
#PORT=8000
#SERVED_MODEL_NAME=mistral-small-4
#SPEC_DRAFT_MODEL=/models/dspark-q8_0.gguf
#SPEC_DRAFT_N_MAX=2
#SPEC_TYPE=draft-dspark,ngram-mod
#TENSOR_SPLIT=1,1
